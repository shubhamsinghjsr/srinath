# Central platform database. Create it in PostgreSQL before starting the API.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/techcoder_platform
# Privileged connection used only for provisioning tenant databases/roles.
POSTGRES_ADMIN_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_CONFIG_ENCRYPTION_KEY=replace-with-a-64-character-random-hex-key
# Shared secret for trusted tenant agents. Sign: timestamp.CODE.students.faculty.campuses with HMAC-SHA256.
TENANT_METRICS_INGEST_SECRET=replace-with-a-random-secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN="8h"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
UPLOAD_DIR="backend/uploads"
