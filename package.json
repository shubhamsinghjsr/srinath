{
  "name": "techcoder-university-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "build:api": "tsc -p backend/tsconfig.json",
    "start:api": "node backend/dist/server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "prisma:seed": "tsx backend/prisma/seed.ts",
    "setup:db": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.1.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "rollup": "npm:@rollup/wasm-node@^4.68.5",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
