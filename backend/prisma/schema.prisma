generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniversityType {
  CENTRAL
  STATE
  PUBLIC
  PRIVATE
  DEEMED
  AUTONOMOUS
  OTHER
}

enum UniversityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ProvisioningStatus {
  NOT_STARTED
  PROVISIONING
  READY
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum LifecycleStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  COMPLETED
  REJECTED
  SUBMITTED
}

enum WorkflowStatus {
  DRAFT
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  UPLOADED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum RecordPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model University {
  id                 String                 @id @default(uuid()) @db.Uuid
  code               String                 @unique @db.VarChar(24)
  name               String                 @db.VarChar(180)
  shortName          String?                @db.VarChar(60)
  type               UniversityType
  establishmentYear  Int?
  registrationNumber String?                @unique @db.VarChar(100)
  website            String?                @db.VarChar(255)
  officialEmail      String                 @db.VarChar(255)
  contactNumber      String                 @db.VarChar(40)
  alternateContactNumber String?             @db.VarChar(40)
  officialFax        String?                @db.VarChar(40)
  category           String?                @db.VarChar(100)
  dateEstablished    DateTime?
  legalEntityName    String?                @db.VarChar(180)
  panNumber          String?                @db.VarChar(20)
  tanNumber          String?                @db.VarChar(20)
  gstNumber          String?                @db.VarChar(30)
  ugcRecognitionStatus String?               @db.VarChar(40)
  ugcRecognitionNumber String?              @db.VarChar(100)
  recognitionDate    DateTime?
  governingAct       String?                @db.VarChar(255)
  governmentNotificationNumber String?       @db.VarChar(100)
  notificationDate   DateTime?
  vision             String?                @db.Text
  mission            String?                @db.Text
  institutionalObjectives String?            @db.Text
  motto              String?                @db.VarChar(255)
  about              String?                @db.Text
  institutionalHistory String?               @db.Text
  coreValues         String?                @db.Text
  websiteDescription String?                @db.Text
  chancellorName     String?                @db.VarChar(160)
  viceChancellorName String?                @db.VarChar(160)
  registrarName      String?                @db.VarChar(160)
  controllerExamName String?                @db.VarChar(160)
  financeOfficerName String?                @db.VarChar(160)
  leadershipEmail    String?                @db.VarChar(255)
  leadershipPhone    String?                @db.VarChar(40)
  status             UniversityStatus      @default(PENDING)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  contact            UniversityContact?
  addresses          UniversityAddress[]
  accreditation      UniversityAccreditation?
  branding           UniversityBranding?
  tenantDatabase     TenantDatabase?
  campuses           Campus[]
  metrics            TenantMetric[]
  subscriptions      UniversitySubscription[]
  auditLogs          PlatformAuditLog[]
  registrations      UniversityRegistration[]
  regulatoryApprovals RegulatoryApproval[]
  accreditationRecords AccreditationRecord[]
  iqacProfile        IqacProfile?
  affiliatedColleges AffiliatedCollege[]
  academicSessions   AcademicSession[]
  academicTerms      AcademicTerm[]
  faculties          Faculty[]
  departments        Department[]
  programmes         Programme[]
  courses            Course[]
  institutionalUsers InstitutionalUser[]
  institutionalLoginLogs InstitutionalLoginLog[]
  institutionalRoles InstitutionalRole[]
  students           Student[]
  employees          Employee[]
  announcements      Announcement[]
  dashboardWidgets  DashboardWidget[]
  configuration      UniversityConfiguration[]
  documents          InstitutionalDocument[]
  approvalRequests   ApprovalRequest[]
  notifications      Notification[]
  erpRecords         ErpRecord[]
  admissionApplications AdmissionApplication[]
  attendanceRecords  AttendanceRecord[]
  examinations       Examination[]
  feeStructures      FeeStructure[]
  feePayments        FeePayment[]
  libraryBooks       LibraryBook[]
  libraryLoans       LibraryLoan[]
  hostelRooms        HostelRoom[]
  hostelAllocations  HostelAllocation[]
  transportRoutes    TransportRoute[]
  transportAllocations TransportAllocation[]
  timetableSlots     TimetableSlot[]
  researchProjects   ResearchProject[]
  researchPublications ResearchPublication[]
  employers          Employer[]
  placementDrives    PlacementDrive[]
  learningMaterials  LearningMaterial[]
  assignments        Assignment[]
  supportTickets     SupportTicket[]
  alumniProfiles     AlumniProfile[]
  inventoryAssets    InventoryAsset[]
  vendors            Vendor[]
  purchaseOrders     PurchaseOrder[]
  reportJobs         ReportJob[]
  tenantAuditLogs    TenantAuditLog[]
  profileVersions    UniversityProfileVersion[]
  iqacMeetings       IqacMeeting[]
  iqacActionReports  IqacActionReport[]
  affiliationRecords AffiliationRecord[]
  hierarchyPositions HierarchyPosition[]
  committees         UniversityCommittee[]
  widgetSettings     DashboardWidgetSetting[]
  workflowDefinitions ApprovalWorkflow[]
  registrationDocuments RegistrationDocument[]
  academicEvents     AcademicCalendarEvent[]
  admissionDocuments AdmissionDocument[]
  supportComments   SupportTicketComment[]

  @@index([status, deletedAt])
  @@index([name])
  @@index([officialEmail])
  @@map("universities")
}

model UniversityContact {
  id                     String     @id @default(uuid()) @db.Uuid
  universityId           String     @unique @db.Uuid
  personName             String     @db.VarChar(160)
  designation            String     @db.VarChar(120)
  email                  String     @db.VarChar(255)
  mobile                 String     @db.VarChar(40)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  university             University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@map("university_contacts")
}

model UniversityAddress {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  addressLine  String     @db.VarChar(255)
  city         String     @db.VarChar(120)
  state        String     @db.VarChar(120)
  country      String     @db.VarChar(100)
  pinCode      String     @db.VarChar(20)
  district     String?    @db.VarChar(120)
  block        String?    @db.VarChar(120)
  latitude     Decimal?   @db.Decimal(10, 7)
  longitude    Decimal?   @db.Decimal(10, 7)
  addressType  String     @default("REGISTERED") @db.VarChar(24)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([country, state, city])
  @@unique([universityId, addressType])
  @@map("university_addresses")
}

model UniversityAccreditation {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @unique @db.Uuid
  body         String?    @db.VarChar(120)
  grade        String?    @db.VarChar(30)
  validUntil   DateTime?
  details      String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@map("university_accreditations")
}

model UniversityBranding {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @unique @db.Uuid
  logoPath     String?    @db.VarChar(500)
  primaryColor String?    @db.VarChar(12)
  secondaryColor String?  @db.VarChar(12)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@map("university_branding")
}

model TenantDatabase {
  id                    String              @id @default(uuid()) @db.Uuid
  universityId          String              @unique @db.Uuid
  databaseName          String              @unique @db.VarChar(63)
  status                ProvisioningStatus  @default(NOT_STARTED)
  encryptedConnection   String?             @db.Text
  lastVerifiedAt        DateTime?
  lastError             String?             @db.VarChar(500)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  university            University          @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("tenant_databases")
}

model Campus {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @db.Uuid
  code         String     @db.VarChar(40)
  name         String     @db.VarChar(180)
  status       String     @default("ACTIVE") @db.VarChar(24)
  campusType   String?    @db.VarChar(60)
  addressLine  String?    @db.VarChar(255)
  city         String?    @db.VarChar(120)
  state        String?    @db.VarChar(120)
  country      String?    @db.VarChar(100)
  pinCode      String?    @db.VarChar(20)
  email        String?    @db.VarChar(255)
  phone        String?    @db.VarChar(40)
  campusHead   String?    @db.VarChar(160)
  facilities   Json?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  colleges     AffiliatedCollege[]
  departments  Department[]
  institutionalUsers InstitutionalUser[]
  students     Student[]
  employees    Employee[]
  erpRecords   ErpRecord[]
  announcements Announcement[]
  documents    InstitutionalDocument[]
  hostelRooms  HostelRoom[]
  transportRoutes TransportRoute[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  inventoryAssets InventoryAsset[]

  @@unique([universityId, code])
  @@index([universityId, deletedAt])
  @@map("campuses")
}

model SubscriptionPlan {
  id            String                   @id @default(uuid()) @db.Uuid
  code          String                   @unique @db.VarChar(40)
  name          String                   @db.VarChar(100)
  priceMonthly  Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("INR") @db.VarChar(3)
  active        Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  subscriptions UniversitySubscription[]

  @@map("subscription_plans")
}

model UniversitySubscription {
  id           String             @id @default(uuid()) @db.Uuid
  universityId String             @db.Uuid
  planId       String             @db.Uuid
  status       SubscriptionStatus @default(TRIAL)
  startsAt     DateTime           @default(now())
  endsAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  university   University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, endsAt])
  @@index([universityId, status])
  @@map("university_subscriptions")
}

model PlatformUser {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(160)
  email        String             @unique @db.VarChar(255)
  passwordHash String             @db.VarChar(255)
  active       Boolean            @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userRoles    PlatformUserRole[]
  auditLogs    PlatformAuditLog[]
  loginLogs    PlatformLoginLog[]

  @@map("platform_users")
}

model PlatformRole {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(60)
  name        String                   @db.VarChar(120)
  description String?                  @db.VarChar(255)
  userRoles   PlatformUserRole[]
  permissions PlatformRolePermission[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(120)
  description String?                  @db.VarChar(255)
  roles       PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformUserRole {
  userId String       @db.Uuid
  roleId String       @db.Uuid
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model PlatformRolePermission {
  roleId       String             @db.Uuid
  permissionId String             @db.Uuid
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("platform_role_permissions")
}

model PlatformAuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String?     @db.Uuid
  universityId String?     @db.Uuid
  action       String      @db.VarChar(120)
  entityType   String      @db.VarChar(80)
  entityId     String?     @db.VarChar(100)
  metadata     Json?
  ipAddress    String?     @db.VarChar(64)
  createdAt    DateTime    @default(now())
  actor        PlatformUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([universityId, createdAt])
  @@map("platform_audit_logs")
}

model PlatformLoginLog {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @db.Uuid
  email      String        @db.VarChar(255)
  tokenId    String?       @unique @db.VarChar(64)
  succeeded  Boolean
  ipAddress  String?       @db.VarChar(64)
  userAgent  String?       @db.VarChar(500)
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  user       PlatformUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("platform_login_logs")
}

model TenantMetric {
  id             String     @id @default(uuid()) @db.Uuid
  universityId   String     @db.Uuid
  studentCount   Int
  facultyCount   Int
  campusCount    Int         @default(0)
  collectedAt    DateTime    @default(now())
  source         String      @db.VarChar(80)
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, collectedAt(sort: Desc)])
  @@map("tenant_metrics")
}

model PlatformSetting {
  key        String   @id @db.VarChar(120)
  value      Json
  updatedAt  DateTime @updatedAt

  @@map("platform_settings")
}

// University/college users are separate from platform super-admin accounts.
model InstitutionalRole {
  id           String                    @id @default(uuid()) @db.Uuid
  universityId String                    @db.Uuid
  code         String                    @db.VarChar(60)
  name         String                    @db.VarChar(120)
  description  String?                   @db.VarChar(255)
  systemRole   Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  university   University                @relation(fields: [universityId], references: [id], onDelete: Restrict)
  users        InstitutionalUserRole[]
  permissions  InstitutionalRolePermission[]
  widgetSettings DashboardWidgetSetting[]

  @@unique([universityId, code])
  @@index([universityId, name])
  @@map("institutional_roles")
}

model InstitutionalPermission {
  id          String                         @id @default(uuid()) @db.Uuid
  code        String                         @unique @db.VarChar(120)
  description String?                        @db.VarChar(255)
  roles       InstitutionalRolePermission[]

  @@map("institutional_permissions")
}

model InstitutionalRolePermission {
  roleId       String                 @db.Uuid
  permissionId String                 @db.Uuid
  role         InstitutionalRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   InstitutionalPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("institutional_role_permissions")
}

model InstitutionalUser {
  id           String                    @id @default(uuid()) @db.Uuid
  universityId String                    @db.Uuid
  campusId     String?                   @db.Uuid
  collegeId    String?                   @db.Uuid
  name         String                    @db.VarChar(160)
  email        String                    @db.VarChar(255)
  passwordHash String                    @db.VarChar(255)
  active       Boolean                   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  university   University                @relation(fields: [universityId], references: [id], onDelete: Restrict)
  campus       Campus?                   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  college      AffiliatedCollege?        @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  userRoles    InstitutionalUserRole[]
  loginLogs    InstitutionalLoginLog[]
  auditLogs    TenantAuditLog[]
  documents    InstitutionalDocument[]   @relation("UploadedBy")
  announcements Announcement[]           @relation("AnnouncementAuthor")
  erpRecords   ErpRecord[]
  widgetSettings DashboardWidgetSetting[]
  approvalRequests ApprovalRequest[]
  approvalSteps ApprovalStep[]
  notifications Notification[]
  reportJobs ReportJob[]

  @@unique([universityId, email])
  @@index([universityId, campusId, collegeId, active])
  @@map("institutional_users")
}

model InstitutionalUserRole {
  userId String             @db.Uuid
  roleId String             @db.Uuid
  user   InstitutionalUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   InstitutionalRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("institutional_user_roles")
}

model InstitutionalLoginLog {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String?            @db.Uuid
  universityId String?         @db.Uuid
  email     String             @db.VarChar(255)
  tokenId   String?            @unique @db.VarChar(64)
  succeeded Boolean
  ipAddress String?            @db.VarChar(64)
  createdAt DateTime           @default(now())
  revokedAt DateTime?
  user      InstitutionalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  university University?       @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([universityId, createdAt])
  @@map("institutional_login_logs")
}

model AffiliatedCollege {
  id             String                 @id @default(uuid()) @db.Uuid
  universityId   String                 @db.Uuid
  campusId       String?                @db.Uuid
  code           String                 @db.VarChar(40)
  name           String                 @db.VarChar(180)
  collegeType    String                 @db.VarChar(60)
  website        String?                @db.VarChar(255)
  principalName  String?                @db.VarChar(160)
  contactPerson  String?                @db.VarChar(160)
  officialEmail  String?                @db.VarChar(255)
  phone          String?                @db.VarChar(40)
  addressLine    String?                @db.VarChar(255)
  district       String?                @db.VarChar(120)
  state          String?                @db.VarChar(120)
  pinCode        String?                @db.VarChar(20)
  status         LifecycleStatus        @default(PENDING)
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  university     University             @relation(fields: [universityId], references: [id], onDelete: Restrict)
  campus         Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  affiliations   AffiliationRecord[]
  programmes     AffiliatedProgramme[]
  users          InstitutionalUser[]
  students       Student[]
  erpRecords     ErpRecord[]

  @@unique([universityId, code])
  @@index([universityId, status, deletedAt])
  @@index([universityId, name])
  @@map("affiliated_colleges")
}

model Faculty {
  id              String       @id @default(uuid()) @db.Uuid
  universityId    String       @db.Uuid
  code            String       @db.VarChar(40)
  name            String       @db.VarChar(160)
  deanName        String?      @db.VarChar(160)
  description     String?      @db.Text
  establishedAt   DateTime?
  status          LifecycleStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  university      University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments     Department[]
  programmes      Programme[]

  @@unique([universityId, code])
  @@index([universityId, status])
  @@map("faculties")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  universityId   String       @db.Uuid
  campusId       String?      @db.Uuid
  facultyId      String?      @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(160)
  hodName        String?      @db.VarChar(160)
  contactEmail   String?      @db.VarChar(255)
  contactPhone   String?      @db.VarChar(40)
  description    String?      @db.Text
  establishedAt  DateTime?
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  university     University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  faculty        Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  programmes     Programme[]
  courses        Course[]
  students       Student[]
  employees      Employee[]
  accreditationMetrics AccreditationMetric[]

  @@unique([universityId, code])
  @@index([universityId, campusId, status])
  @@index([facultyId])
  @@map("departments")
}

model Programme {
  id                 String       @id @default(uuid()) @db.Uuid
  universityId       String       @db.Uuid
  facultyId          String?      @db.Uuid
  departmentId       String       @db.Uuid
  code               String       @db.VarChar(40)
  name               String       @db.VarChar(180)
  level              String       @db.VarChar(40)
  programmeType      String?      @db.VarChar(60)
  durationMonths     Int?
  totalSemesters     Int?
  totalCredits       Decimal?     @db.Decimal(7, 2)
  eligibility        String?      @db.Text
  approvedIntake     Int?
  status             LifecycleStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  university         University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  faculty            Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department         Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  collegeProgrammes  AffiliatedProgramme[]
  courses            Course[]
  students           Student[]
  admissionApplications AdmissionApplication[]
  feeStructures      FeeStructure[]
  placementApplications PlacementApplication[]
  learningMaterials  LearningMaterial[]
  assignments        Assignment[]

  @@unique([universityId, code])
  @@index([universityId, departmentId, status])
  @@map("programmes")
}

model AffiliatedProgramme {
  id             String           @id @default(uuid()) @db.Uuid
  collegeId      String           @db.Uuid
  programmeId    String           @db.Uuid
  affiliationId  String?          @db.Uuid
  approvedIntake Int?
  courseLevel    String?          @db.VarChar(40)
  durationMonths Int?
  validFrom      DateTime?
  validUntil     DateTime?
  status         LifecycleStatus  @default(PENDING)
  createdAt      DateTime         @default(now())
  college        AffiliatedCollege @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  programme      Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  affiliation    AffiliationRecord? @relation(fields: [affiliationId], references: [id], onDelete: SetNull)

  @@unique([collegeId, programmeId, validFrom])
  @@index([collegeId, status, validUntil])
  @@map("affiliated_programmes")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  universityId   String       @db.Uuid
  programmeId    String       @db.Uuid
  departmentId   String       @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(180)
  semesterNumber Int?
  subjectType    String?      @db.VarChar(40)
  theoryCredits  Decimal      @default(0) @db.Decimal(5, 2)
  practicalCredits Decimal    @default(0) @db.Decimal(5, 2)
  tutorialCredits Decimal     @default(0) @db.Decimal(5, 2)
  maximumMarks   Decimal?     @db.Decimal(7, 2)
  minimumMarks   Decimal?     @db.Decimal(7, 2)
  syllabus       String?      @db.Text
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
