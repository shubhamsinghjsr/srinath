}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  universityId String         @db.Uuid
  studentId    String?        @db.Uuid
  assignedEmployeeId String?  @db.Uuid
  ticketNumber String         @db.VarChar(60)
  category     String         @db.VarChar(80)
  subject      String         @db.VarChar(200)
  description  String         @db.Text
  priority     RecordPriority @default(MEDIUM)
  status       LifecycleStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  university   University     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  student      Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?  @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  comments     SupportTicketComment[]

  @@unique([universityId, ticketNumber])
  @@index([universityId, status, priority, createdAt])
  @@map("support_tickets")
}

model SupportTicketComment {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  ticketId     String       @db.Uuid
  authorId     String?      @db.Uuid
  body         String       @db.Text
  internal     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([universityId, ticketId, createdAt])
  @@map("support_ticket_comments")
}

model AlumniProfile {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  studentId    String?      @unique @db.Uuid
  alumniNumber String       @db.VarChar(60)
  graduationYear Int
  employer     String?      @db.VarChar(180)
  jobTitle     String?      @db.VarChar(120)
  email        String?      @db.VarChar(255)
  phone        String?      @db.VarChar(40)
  visibility   String       @default("PRIVATE") @db.VarChar(24)
  createdAt    DateTime     @default(now())
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([universityId, alumniNumber])
  @@index([universityId, graduationYear])
  @@map("alumni_profiles")
}

model InventoryAsset {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  campusId     String?      @db.Uuid
  vendorId     String?      @db.Uuid
  assetCode    String       @db.VarChar(80)
  name         String       @db.VarChar(180)
  category     String       @db.VarChar(80)
  serialNumber String?      @db.VarChar(120)
  purchasedAt  DateTime?
  purchaseCost Decimal?     @db.Decimal(14, 2)
  status       LifecycleStatus @default(ACTIVE)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([universityId, assetCode])
  @@index([universityId, campusId, category, status])
  @@map("inventory_assets")
}

model Vendor {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  code         String       @db.VarChar(60)
  name         String       @db.VarChar(180)
  taxNumber    String?      @db.VarChar(40)
  email        String?      @db.VarChar(255)
  phone        String?      @db.VarChar(40)
  address      String?      @db.VarChar(255)
  status       LifecycleStatus @default(ACTIVE)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  assets       InventoryAsset[]
  purchaseOrders PurchaseOrder[]

  @@unique([universityId, code])
  @@index([universityId, name])
  @@map("vendors")
}

model PurchaseOrder {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  vendorId     String       @db.Uuid
  orderNumber  String       @db.VarChar(80)
  orderedAt    DateTime     @default(now())
  expectedAt   DateTime?
  totalAmount  Decimal      @db.Decimal(14, 2)
  status       WorkflowStatus @default(DRAFT)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]

  @@unique([universityId, orderNumber])
  @@index([universityId, status, orderedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  purchaseOrderId String      @db.Uuid
  itemName       String       @db.VarChar(180)
  quantity       Decimal      @db.Decimal(12, 3)
  unitPrice      Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model EmployeeLeave {
  id          String       @id @default(uuid()) @db.Uuid
  employeeId  String       @db.Uuid
  leaveType   String       @db.VarChar(60)
  startsOn    DateTime     @db.Date
  endsOn      DateTime     @db.Date
  reason      String?      @db.Text
  status      WorkflowStatus @default(SUBMITTED)
  reviewedBy  String?      @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startsOn, endsOn, status])
  @@map("employee_leaves")
}

model PayrollRecord {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @db.Uuid
  payrollMonth  String       @db.VarChar(7)
  grossAmount   Decimal      @db.Decimal(14, 2)
  deductions    Decimal      @default(0) @db.Decimal(14, 2)
  netAmount     Decimal      @db.Decimal(14, 2)
  status        String       @default("DRAFT") @db.VarChar(30)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, payrollMonth])
  @@index([payrollMonth, status])
  @@map("payroll_records")
}

model ReportJob {
  id             String       @id @default(uuid()) @db.Uuid
  universityId   String       @db.Uuid
  requestedById  String?      @db.Uuid
  reportType     String       @db.VarChar(100)
  filters        Json?
  filePath       String?      @db.VarChar(500)
  status         LifecycleStatus @default(PENDING)
  requestedAt    DateTime     @default(now())
  completedAt    DateTime?
  university     University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  requestedBy    InstitutionalUser? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([universityId, status, requestedAt])
  @@map("report_jobs")
}
